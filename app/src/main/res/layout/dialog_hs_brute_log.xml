<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/light_contrast"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/light_lite_contrast"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/hs_brute_log_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cracking"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap the handshake row again to reopen this window."
            android:textColor="@color/grey"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/hs_brute_log"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:background="#0D000000"
            android:fontFamily="monospace"
            android:gravity="top|start"
            android:padding="10dp"
            android:scrollbars="vertical"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hs_brute_log_hide"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Hide" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
