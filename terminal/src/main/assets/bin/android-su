#!/system/bin/sh
# Version: 2.3.0
#
# Root Android shell (NON-chroot). KernelSU/APatch/Magisk friendly.
# Avoid nested `su -c "exec …"` which often returns "Permission denied"
# under KernelSU when launched from a PTY.

STRYKER_FILES=/data/data/com.zalexdev.stryker/files
BASH="$STRYKER_FILES/usr/bin/bash"

export PATH=$STRYKER_FILES/usr/bin:$STRYKER_FILES/usr/sbin:/sbin:/system/bin:/system/xbin:/system/sbin:/su/bin:/magisk/.core/bin:/debug_ramdisk:/data/adb/ksu/bin:/data/adb/ap/bin:/apex/com.android.runtime/bin:/apex/com.android.art/bin:/odm/bin:/vendor/bin:.
unset LD_LIBRARY_PATH
unset LD_PRELOAD
export HOME=/
export PS1="\\[\\e[1;32m\\]\\u [ \\[\\e[0m\\]\\w\\[\\e[1;32m\\] ]\$ \\[\\e[0m\\]"

clear

SU=
for c in \
    /debug_ramdisk/su \
    /data/adb/ksu/bin/su \
    /data/adb/ap/bin/su \
    /system/xbin/su \
    /system/bin/su \
    /sbin/su \
    /su/bin/su \
    su
do
    if [ -x "$c" ]; then SU="$c"; break; fi
done
[ -z "$SU" ] && SU=su

SHELL_BIN="$BASH"
[ -x "$SHELL_BIN" ] || SHELL_BIN=/system/bin/sh

echo "[*] SU=$SU"
echo "[*] shell=$SHELL_BIN"

# Magisk: su -mm keeps global mount namespace.
if "$SU" -mm -c "id -u" >/dev/null 2>&1; then
    if [ -x "$BASH" ]; then
        exec "$SU" -mm -s "$BASH"
    fi
    exec "$SU" -mm
fi

# KernelSU / APatch: prefer handing the shell path to su (no -c quoting).
# Fall back through common forms; print a clear hint on failure.
if [ -x "$SHELL_BIN" ]; then
    "$SU" "$SHELL_BIN" && exit $?
    "$SU" -s "$SHELL_BIN" && exit $?
    "$SU" -- "$SHELL_BIN" && exit $?
    "$SU" -c "$SHELL_BIN" && exit $?
fi

"$SU" && exit $?

echo "[-] Root shell failed (Permission denied?)."
echo "    In KernelSU/Magisk Manager, grant root to: com.zalexdev.stryker"
echo "    Then reopen Terminal → Android SU."
exec /system/bin/sh
